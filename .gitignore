# Data — raw files don't go in git, regenerate via scripts/
data/raw/*
data/processed/*
data/interim/*
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/.gitkeep
*.csv
*.parquet
*.feather
*.pkl
*.joblib

# Models — MLflow tracks these
models/*
!models/.gitkeep
mlruns/
mlartifacts/

# Logs
logs/
*.log

# Prefect
.prefect/

# Misc
.pytest_cache/
*.tmp
*.bak
