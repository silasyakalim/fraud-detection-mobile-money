# Copy to .env and fill in real values. Never commit .env.

# Kaggle API credentials (for downloading PaySim)
# Get from kaggle.com → Settings → API → Create New Token
KAGGLE_USERNAME=your_username
KAGGLE_KEY=your_kaggle_api_key

# MLflow tracking server
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=fraud-detection

# Prefect
PREFECT_API_URL=http://localhost:4200/api

# Data paths (relative to repo root)
DATA_RAW_DIR=data/raw
DATA_PROCESSED_DIR=data/processed
MODELS_DIR=models

# Logging
LOG_LEVEL=INFO

# Cost-sensitive evaluation defaults (used in metrics.py)
# Cost of a missed fraud (false negative) vs investigator review (false positive)
COST_FALSE_NEGATIVE=500.0
COST_FALSE_POSITIVE=10.0
